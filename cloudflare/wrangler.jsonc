{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phosters",
  "main": "worker.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/sw.js",
      "/manifest.webmanifest"
    ]
  },
  "triggers": {
    "crons": [
      "0 16 * * *"
    ]
  }
}
